  "connections": {
    "Workflow Failed": {
      "main": [
        [
          {
            "node": "Persist Failure and Notify Local Dispatch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  }
}
